# 이 파일을 .env.local로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.

# --- 서버 전용 (클라이언트 번들에 포함되지 않음) ---

# 외부 REST API 베이스 URL. production 빌드에서 필수.
# 목업 모드(NEXT_PUBLIC_API_MOCKING=enabled)에서도 서버 fetcher가 절대 URL을
# 요구한다. MSW가 요청을 가로채므로 값 자체는 백엔드에 도달하지 않는다 —
# 목업만 쓸 때는 아래처럼 아무 절대 URL로 채운다.
API_BASE_URL=http://localhost:3000

# ISR 재검증 웹훅의 HMAC 서명 검증용 시크릿. production 빌드에서 필수.
REVALIDATE_WEBHOOK_SECRET=

# --- 공개 (NEXT_PUBLIC_ 접두사 → 클라이언트 번들에 노출됨) ---

# 토스페이먼츠 결제창 클라이언트 키.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# "enabled"로 설정하면 MSW 목업으로 동작(백엔드 불필요). 비우면 실제 백엔드로 요청.
# 서버(RSC/ISR)는 instrumentation이 Node MSW를, 브라우저는 부팅 시 auth-bootstrap이
# 워커를 띄운다. 서버·클라이언트 양쪽에서 읽어야 해 NEXT_PUBLIC_ 접두사를 쓴다.
NEXT_PUBLIC_API_MOCKING=enabled
